# Database
# Local: mysql://user:password@localhost:3306/dbname
# Production (with pooling): mysql://user:password@host:3306/dbname?schema=public&connection_limit=10
DATABASE_URL="mysql://user:password@localhost:3306/sewa_lapangan_padel"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Server
PORT=5000
NODE_ENV="development"

# Frontend URL (untuk Midtrans callback)
FRONTEND_URL="http://localhost:3000"

# Midtrans Payment Gateway
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"

# Email (untuk OTP)
# Gunakan Google App Password, bukan password akun Google biasa
# Settings: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-16-chars"

# Optional: For production uptime monitoring
# HEALTH_CHECK_URL="http://your-uptime-monitor.com"
